{
  "compilerOptions": {
    "target": "ES2022", "module": "preserve", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "skipLibCheck": true,
    "experimentalDecorators": true, "useDefineForClassFields": false,
    "esModuleInterop": true, "jsx": "react-jsx", "resolveJsonModule": true,
    "isolatedModules": true, "noFallthroughCasesInSwitch": true,
    "baseUrl": ".", "paths": { "@rescueflow/*": ["packages/*"] }
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "packages/**/*.tsx"]
}
