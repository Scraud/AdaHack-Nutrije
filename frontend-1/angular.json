{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "dispatcher": {
      "projectType": "application",
      "root": "apps/dispatcher",
      "sourceRoot": "apps/dispatcher/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/dispatcher",
            "browser": "apps/dispatcher/src/main.ts",
            "index": "apps/dispatcher/src/index.html",
            "tsConfig": "tsconfig.json",
            "allowedCommonJsDependencies": ["react", "react-dom", "leaflet"],
            "styles": ["leaflet/dist/leaflet.css", "apps/dispatcher/src/styles.css"]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "dispatcher:build" }
        }
      }
    }
  }
}
