RESCUEFLOW_DB=/data/rescueflow.sqlite
RESCUEFLOW_PORT=8080
# Optional URL for the independent OSRM routing health check.
RESCUEFLOW_OSRM_URL=
# Optional authorized NAP DATEX II feed, for example https://b2b.nap.si/data/b2b.events.
RESCUEFLOW_NAP_URL=
RESCUEFLOW_NAP_TOKEN=
# Optional bearer key for a separate GPS feed. Leave blank for demo playback.
RESCUEFLOW_GPS_KEY=
